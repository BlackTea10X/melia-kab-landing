---
import "../styles/global.css";

const siteUrl = "https://meliakab.netlify.app";

const pageTitle = "MELIA KÁB | Miel de Melipona";
const pageDescription =
  "Miel artesanal de abeja melipona inspirada en la tradición maya. Producto natural, premium y mexicano.";

const ogImage = `${siteUrl}/images/og-image.webp`;

const whatsappNumber = "529821070644";
const whatsappMessage = "Hola, quiero más información sobre la miel MELIA KÁB.";
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
  whatsappMessage,
)}`;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <header class="site-header">
      <a href="#inicio" class="brand brand-with-logo" aria-label="Ir al inicio">
        <img
          src="/images/logo.png"
          alt="Logo de MELIA KÁB"
          width="48"
          height="48"
        />
        <span>MELIA KÁB</span>
      </a>

      <nav class="nav" aria-label="Navegación principal">
        <a href="#producto">Producto</a>
        <a href="#catalogo">Catálogo</a>
        <a href="#precios">Precios</a>
        <a href="#ubicacion">Ubicación</a>
        <a href="#contacto">Contacto</a>
      </nav>

      <a
        class="header-button"
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
      >
        WhatsApp
      </a>
    </header>

    <main>
      <section id="inicio" class="hero section">
        <div class="hero-content">
          <p class="eyebrow">Miel artesanal mexicana</p>
          <h1>MELIA KÁB</h1>
          <p class="slogan">Elixir Sagrado de la Dama Maya</p>
          <p class="hero-text">
            Desde las antiguas tradiciones de la cultura maya hasta tu mesa. Una
            miel de melipona de origen artesanal, sabor floral y carácter
            premium.
          </p>

          <div class="hero-actions">
            <a class="primary-button" href="#catalogo">Ver catálogo</a>
            <a
              class="secondary-button"
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
            >
              Hacer pedido
            </a>
          </div>
        </div>

        <div class="hero-image-card">
          <img
            class="js-lightbox-image"
            src="/images/melia-hero.webp"
            alt="Anuncio promocional de miel MELIA KÁB"
            width="1200"
            height="630"
          />
        </div>
      </section>

      <section id="producto" class="section product-section">
        <div class="section-heading">
          <p class="eyebrow">Producto</p>
          <h2>Miel de abeja melipona</h2>
          <p>
            MELIA KÁB es una miel artesanal elaborada por abejas meliponas,
            reconocida por su sabor delicado, textura fluida y valor cultural.
          </p>
        </div>

        <div class="features-grid">
          <article class="feature-card">
            <span aria-hidden="true">✦</span>
            <h3>100% miel de melipona</h3>
            <p>Producto natural de especialidad, ideal para consumo gourmet.</p>
          </article>

          <article class="feature-card">
            <span aria-hidden="true">✦</span>
            <h3>Producción artesanal</h3>
            <p>Elaborada en pequeña escala, cuidando su origen y calidad.</p>
          </article>

          <article class="feature-card">
            <span aria-hidden="true">✦</span>
            <h3>Origen maya</h3>
            <p>Inspirada en la tradición de la abeja Xunán Kab.</p>
          </article>

          <article class="feature-card">
            <span aria-hidden="true">✦</span>
            <h3>Calidad premium</h3>
            <p>Color ámbar, notas florales y presentación elegante.</p>
          </article>
        </div>
      </section>

      <section id="catalogo" class="section catalog-section">
        <div class="section-heading">
          <p class="eyebrow">Catálogo</p>
          <h2>Presentaciones disponibles</h2>
          <p>
            Opciones pensadas para consumo personal, regalo o compra especial.
            Da clic en las imágenes para verlas con mayor detalle.
          </p>
        </div>

        <div class="catalog-grid">
          <article class="product-card">
            <img
              class="product-image js-lightbox-image"
              src="/images/presentacion-250g.webp"
              alt="Frasco individual de miel MELIA KÁB de 250 gramos"
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <h3>Frasco individual</h3>
            <p class="product-size">250 g</p>
            <p>Miel de melipona en presentación premium.</p>
            <strong>$500 MXN</strong>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer">
              Pedir por WhatsApp
            </a>
          </article>

          <article class="product-card featured">
            <img
              class="product-image js-lightbox-image"
              src="/images/paquete-regalo.webp"
              alt="Paquete regalo de MELIA KÁB con dos frascos de miel de melipona"
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <h3>Paquete regalo</h3>
            <p class="product-size">2 frascos de 250 g</p>
            <p>
              Opción ideal para obsequios, detalles especiales o consumo
              familiar.
            </p>
            <strong>$800 MXN</strong>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer">
              Pedir por WhatsApp
            </a>
          </article>

          <article class="product-card">
            <img
              class="product-image js-lightbox-image"
              src="/images/pedido-especial.webp"
              alt="Pedido especial de miel MELIA KÁB para eventos o mayoreo"
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
            />
            <h3>Paquete especial</h3>
            <p class="product-size">Mayoreo o eventos</p>
            <p>
              Presentación para eventos, regalos empresariales o pedidos
              especiales.
            </p>
            <strong>Cotización</strong>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer">
              Contactar para cotización
            </a>
          </article>
        </div>
      </section>

      <section id="precios" class="section price-section">
        <div class="section-heading">
          <p class="eyebrow">Precio</p>
          <h2>Precios, promociones y formas de pago</h2>
        </div>

        <div class="info-panel">
          <ul>
            <li>Frasco de 250 g: $500 MXN.</li>
            <li>Paquete de 2 frascos: $800 MXN.</li>
            <li>Paquete de 6 frascos: $2500 MXN.</li>
            <li>
              Pago en efectivo, transferencia bancaria y tarjetas de
              débito/crédito.
            </li>
            <li>Empaque especial para regalo bajo solicitud.</li>
          </ul>
        </div>
      </section>

      <section class="section story-section">
        <div class="story-content">
          <p class="eyebrow">Historia</p>
          <h2>Una tradición milenaria en cada frasco</h2>
          <p>
            La miel de melipona ha sido apreciada por generaciones por su sabor
            excepcional, su delicado aroma floral y su vínculo con la cultura
            maya. MELIA KÁB busca transmitir esa herencia natural en una
            presentación artesanal, elegante y mexicana.
          </p>
        </div>
      </section>

      <section id="ubicacion" class="section location-section">
        <div class="section-heading">
          <p class="eyebrow">Plaza</p>
          <h2>Ubicación y entregas</h2>
          <p>
            Producto mexicano con origen en Campeche. Consulta disponibilidad,
            entregas locales y envíos bajo cotización.
          </p>
        </div>

        <div class="location-grid">
          <div class="info-panel">
            <h3>Datos de atención</h3>
            <p>
              <strong>Dirección:</strong> Candelaria Campeche CP 24330 Colonia Acalan
              calle 31 2A / 2B No.27
            </p>
            <p>
              <strong>Horario:</strong> Lunes a sábado, 9:00 a.m. a 6:00 p.m.
            </p>
            <p>
              <strong>Entregas:</strong> Locales y nacionales bajo cotización.
            </p>
          </div>

          <div class="map-card">
            <iframe
              class="map-frame"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3790.3051325247898!2d-91.0423139!3d18.195896599999998!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85f6a573ae58de0f%3A0xb2b8adae8cb043fb!2sC.%2031%20632%2C%20Acal%C3%A1n%2C%2024330%20Candelaria%2C%20Camp.!5e0!3m2!1ses!2smx!4v1780530981302!5m2!1ses!2smx"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicación de MELIA KÁB"></iframe>
          </div>
        </div>
      </section>

      <section class="section media-section">
        <div class="section-heading">
          <p class="eyebrow">Promoción</p>
          <h2>Video promocional</h2>
        </div>

        <div class="video-card">
          <video controls preload="metadata" poster="/images/melia-hero.webp">
            <source src="/videos/melia-video.mp4" type="video/mp4" />
            Tu navegador no soporta video.
          </video>
        </div>
      </section>

      <section id="contacto" class="section contact-section">
        <div class="contact-card">
          <p class="eyebrow">Contacto</p>
          <h2>Haz tu pedido o solicita más información</h2>
          <p>
            Comunícate con MELIA KÁB para consultar precios, disponibilidad,
            entregas y pedidos especiales.
          </p>

          <div class="contact-links">
            <a
              class="primary-button"
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
            >
              Contactar por WhatsApp
            </a>
            <a class="secondary-button" href="mailto:contacto@meliakab.com">
              Enviar correo
            </a>
          </div>

          <div class="social-data">
            <p><strong>Teléfono:</strong> +52 982 107 0644</p>
            <p><strong>Correo:</strong> contacto@meliakab.com</p>
            <p><strong>Instagram:</strong> @meliakab</p>
            <p><strong>Facebook:</strong> MELIA KÁB</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>MELIA KÁB · Elixir Sagrado de la Dama Maya</p>
      <p>Producto mexicano · Producción artesanal · Miel de melipona</p>
    </footer>

    <div class="lightbox" id="lightbox" aria-hidden="true">
      <button
        class="lightbox-close"
        type="button"
        id="lightboxClose"
        aria-label="Cerrar imagen ampliada"
      >
        ×
      </button>

      <img id="lightboxImage" src="" alt="" />
      <p id="lightboxCaption"></p>
    </div>

    <script is:inline>
      const lightbox = document.getElementById("lightbox");
      const lightboxImage = document.getElementById("lightboxImage");
      const lightboxCaption = document.getElementById("lightboxCaption");
      const lightboxClose = document.getElementById("lightboxClose");
      const images = document.querySelectorAll(".js-lightbox-image");

      function openLightbox(image) {
        if (!lightbox || !lightboxImage || !lightboxCaption) return;

        lightboxImage.src = image.currentSrc || image.src;
        lightboxImage.alt = image.alt || "Imagen ampliada del producto";
        lightboxCaption.textContent = image.alt || "";

        lightbox.classList.add("is-open");
        lightbox.setAttribute("aria-hidden", "false");
        document.body.classList.add("no-scroll");
      }

      function closeLightbox() {
        if (!lightbox || !lightboxImage || !lightboxCaption) return;

        lightbox.classList.remove("is-open");
        lightbox.setAttribute("aria-hidden", "true");
        document.body.classList.remove("no-scroll");

        lightboxImage.src = "";
        lightboxCaption.textContent = "";
      }

      images.forEach((image) => {
        image.addEventListener("click", () => openLightbox(image));
      });

      lightboxClose?.addEventListener("click", closeLightbox);

      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) {
          closeLightbox();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeLightbox();
        }
      });
    </script>
  </body>
</html>
